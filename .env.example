# Copy this file to .env for local development:
#
#   cp .env.example .env          (macOS / Linux)
#   copy .env.example .env        (Windows)
#
# .env is gitignored. Real environment variables always override these values,
# so the same settings module works unchanged in production.

# ── Local development ────────────────────────────────────────────────────────

# Serves tracebacks and disables several security checks. Never enable this on
# a public host.
DJANGO_DEBUG=True

# Required as soon as DJANGO_DEBUG is off. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# DJANGO_SECRET_KEY=

# Comma-separated. Add your host here before deploying anywhere.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Marks session and CSRF cookies secure, which means the browser will not send
# them over plain HTTP. Set to False if you run `manage.py runserver` instead
# of run_https.sh, otherwise you will not be able to stay logged in.
DJANGO_USE_HTTPS=True

# ── Conversion service ───────────────────────────────────────────────────────

# Change the port here if you run the server on anything other than 8000.
DJANGO_CONVERSION_SERVICE_URL=https://localhost:8000/webapps2026/conversion
DJANGO_CONVERSION_TIMEOUT=3

# Off locally because the development server uses a self-signed certificate.
# Turn on once the service sits behind a certificate the client can verify.
DJANGO_CONVERSION_VERIFY_TLS=False

# ── Application ──────────────────────────────────────────────────────────────

# Opening balance for a new account, converted into their chosen currency.
DJANGO_INITIAL_BALANCE_GBP=500.00

# Read by `manage.py create_admin --noinput` so the password stays out of your
# shell history. Leave unset to be prompted instead.
# DJANGO_ADMIN_PASSWORD=
